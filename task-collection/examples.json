            "importance": "important"
          },
          {
            "id": "vsd-evidence-4-2",
            "description": "If visible: hole centre (x, y, z), with coordinate system and units (e.g. RAS, mm).",
            "importance": "essential"
          }
        ]
      },
      {
        "id": "vsd-step-5",
        "description": "Decide whether an opening is visible.",
        "toolIds": [
          "tool-slicer"
        ],
        "modalityIds": [
          "modality-mri"
        ],
        "evidence": []
      }
    ],
    "expectedResult": "Opening seen / not seen / uncertain, supported by the recorded evidence.",
