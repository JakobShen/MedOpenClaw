        {
          "id": "tool-slicer",
          "name": "3D Slicer"
        }
      ],
      "modalities": [
        {
          "id": "modality-mri",
          "name": "MRI"
        }
      ],
      "note": "Link saved images and coordinates to the source series and cine frame. Importance labels are illustrative."
    },
    "steps": [
      {
        "id": "vsd-step-1",
        "description": "Open the MRI.",
        "toolIds": [
          "tool-slicer"
        ],
        "modalityIds": [
          "modality-mri"
        ],
        "evidence": []
      },
      {
        "id": "vsd-step-2",
        "description": "Segment the ventricles, if helpful.",
        "toolIds": [
          "tool-slicer"
        ],
        "modalityIds": [
          "modality-mri"
        ],
        "evidence": []
      },
      {
        "id": "vsd-step-3",
        "description": "Adjust the views to show the wall between the ventricles.",
        "toolIds": [
          "tool-slicer"
        ],
        "modalityIds": [
          "modality-mri"
        ],
        "evidence": []
      },
      {
        "id": "vsd-step-4",
        "description": "Inspect the slices and cine frames.",
        "toolIds": [
          "tool-slicer"
        ],
        "modalityIds": [
          "modality-mri"
        ],
        "evidence": [
          {
            "id": "vsd-evidence-4-1",
